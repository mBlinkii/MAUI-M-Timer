<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <!-- Module base class (must load before any module). Every Options.lua,
         the Splits manager, the checkpoint editor, the changelog page and the
         setup wizard live in the load-on-demand addon MauiMPlusTimer_Options. -->
    <Script file="ModuleTemplate.lua"/>

    <!-- Dungeon (name, keystone level, affixes) -->
    <Script file="Dungeon\Module.lua"/>
    <Script file="Dungeon\UI.lua"/>

    <!-- Timer (main bar, thresholds, countdowns) -->
    <Script file="Timer\Module.lua"/>
    <Script file="Timer\Data.lua"/>
    <Script file="Timer\UI.lua"/>

    <!-- Enemy Forces (progress bar + markers) -->
    <Script file="EnemyForces\Module.lua"/>
    <Script file="EnemyForces\Data.lua"/>
    <Script file="EnemyForces\UI.lua"/>

    <!-- Objectives (boss list + per-boss times/deltas) -->
    <Script file="Objectives\Module.lua"/>
    <Script file="Objectives\Data.lua"/>
    <Script file="Objectives\UI.lua"/>

    <!-- Deaths (counter + time penalty) -->
    <Script file="Deaths\Module.lua"/>
    <Script file="Deaths\UI.lua"/>

    <!-- Splits (best-run recording + live comparison) -->
    <Script file="Splits\Module.lua"/>
    <Script file="Splits\Data.lua"/>
    <Script file="Splits\UI.lua"/>

    <!-- Checkpoints (custom waypoints) -->
    <Script file="Checkpoints\Module.lua"/>
    <Script file="Checkpoints\Data.lua"/>
    <Script file="Checkpoints\UI.lua"/>

    <!-- Cooldowns (battle res / heroism tracking) -->
    <Script file="Cooldowns\Module.lua"/>
    <Script file="Cooldowns\UI.lua"/>

    <!-- Sound (event-triggered audio cues) -->
    <Script file="Sound\Module.lua"/>
    <Script file="Sound\Data.lua"/>

    <!-- Automation (tracker hiding, keystone auto-slot) -->
    <Script file="Automation\Module.lua"/>

    <!-- Changelog (one-time update popup; the page itself is in the settings) -->
    <Script file="Changelog\Module.lua"/>

    <!-- Setup (first-start trigger; the wizard itself is in the settings) -->
    <Script file="Setup\Module.lua"/>
</Ui>
